# Copy to .env for local development ONLY. Never commit .env.
# In production set these in Netlify → Site configuration → Environment variables,
# scoped to "Functions" (none of them are needed at build time except for the warnings).

# --- SphereMail -------------------------------------------------------------
# API base. Leave as is unless SphereMail gives you an operator-specific URL.
SPHEREMAIL_API_BASE=https://api.spheremail.co/v1
# Optional JSON object of extra headers SphereMail asks you to send (operator scoping), e.g. {"X-Operator":"bizloft"}
SPHEREMAIL_EXTRA_HEADERS=
# Plan IDs from GET /plans/ in your SphereMail account. A plan left blank shows "Enquire" instead of signup.
SPHEREMAIL_PLAN_MAILBOX_ONLY=
SPHEREMAIL_PLAN_VIRTUAL_OFFICE=
SPHEREMAIL_PLAN_VIRTUAL_OFFICE_PLUS=
# Where customers sign in to add a card and upload ID (your SphereMail customer portal URL).
SPHEREMAIL_PORTAL_URL=
# SphereMail requires country_id / state_id / zip_code. The functions look them up via GET /countries;
# set these to override if the lookup doesn't match (ask SphereMail support for the IDs).
SPHEREMAIL_COUNTRY_ID_GY=
SPHEREMAIL_STATE_ID_GY=
SPHEREMAIL_STATE_ID_DEFAULT=
SPHEREMAIL_DEFAULT_ZIP=00000
SPHEREMAIL_TIMEOUT_MS=10000

# Hosted signup (recommended to start): send plan buttons to SphereMail's own signup page
# instead of the in-page form. Must be https. Leave blank to use the in-page form.
SPHEREMAIL_SIGNUP_URL=
# Which plans use the hosted page (comma-separated keys). Virtual Office Plus is left out by default.
SPHEREMAIL_HOSTED_PLANS=mailbox_only,virtual_office

# --- Cloudflare Turnstile (free bot check on the "email me a code" step) -----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Business-registration form -> Google Sheets (see google-apps-script/README.md) ---
# The Apps Script web app URL (ends in /exec) and the shared secret set as SHARED_SECRET in the script.
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=
GOOGLE_SCRIPT_TIMEOUT_MS=9000

# --- Origins allowed to call /api (Netlify adds the deploy URLs automatically) --
ALLOWED_ORIGINS=https://www.bizloftgy.com,https://bizloftgy.com

# --- Local development only ---------------------------------------------------
# SPHEREMAIL_MOCK=1 fakes SphereMail so you can click through signup (code 123456 works, 000000 fails,
# taken@example.com is "already registered"). The deploy is blocked if this is set in production.
SPHEREMAIL_MOCK=1
LOCAL_DEV=1
